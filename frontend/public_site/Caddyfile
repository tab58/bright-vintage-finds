:{$PORT:8080}

root * /srv
encode gzip

# The inventory PWA and the admin API are served from one origin so the
# Cloudflare Access cookie is first-party and no CORS preflight is involved.
# API_UPSTREAM is the API's Railway private domain (IPv6-only internal DNS).
handle /admin/* {
	reverse_proxy {$API_UPSTREAM:http://bright-vintage-finds.railway.internal:8080}
}

# The public shop front reads its catalog from the same API, unauthenticated.
handle /public/* {
	reverse_proxy {$API_UPSTREAM:http://bright-vintage-finds.railway.internal:8080}
}

# Runtime config: BACKEND_API is substituted from the environment when the
# Caddyfile is parsed, so the same image works across environments. Empty in
# production now that /admin is proxied here: the client falls back to a
# same-origin base.
handle /env.js {
	header Content-Type "text/javascript; charset=utf-8"
	# Runtime config, not a static asset: without this Cloudflare caches it by
	# the .js extension and serves a stale BACKEND_API for hours after a deploy.
	header Cache-Control "no-store"
	respond `window.BACKEND_API = "{$BACKEND_API}";`
}

handle {
	try_files {path} /index.html
	file_server
}
