:{$PORT:8080}

root * /srv
encode gzip

# Runtime config: BACKEND_API is substituted from the environment when the
# Caddyfile is parsed, so the same image works across environments.
handle /env.js {
	header Content-Type "text/javascript; charset=utf-8"
	respond `window.BACKEND_API = "{$BACKEND_API}";`
}

handle {
	try_files {path} /index.html
	file_server
}
