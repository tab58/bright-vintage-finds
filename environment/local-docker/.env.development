#/-------------------[DOTENV_PUBLIC_KEY]--------------------/
#/            public-key encryption for .env files          /
#/       [how it works](https://dotenvx.com/encryption)     /
#/----------------------------------------------------------/
DOTENV_PUBLIC_KEY_DEVELOPMENT="02f992b7da3871f2a42cc9b2a868f69bd89a2c781c57d2d401bb4e27c247b5972d"

# Combined host-process env vars for local-docker/docker-compose.yml.
# Loaded by `task up` (repo root), which wraps
# `dotenvx run -f .env.development -- docker compose up`.
# Fill in blanks as needed.

ENV="development"

# Dev-only JWT signing secret — never use in production.
JWT_SIGNING_SECRET="local-dev-jwt-secret"

# --- Postgres (db-main) -----------------------------------------------------
MAIN_DB_POSTGRES_USER="postgres"
MAIN_DB_POSTGRES_PASSWORD="postgres"
MAIN_DB_POSTGRES_DB="maindb"

# --- AWS --------------------------------------------------------------------
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="floci"
AWS_SECRET_ACCESS_KEY="floci"

S3_BASE_ENDPOINT="http://floci:4566"


# --- Cloudflare Access (optional; /admin route verification) -----------------
# Leave blank in local dev: main-api runs with ENV=development, which leaves
# /admin open locally. Set both to test edge-verified admin requests:
# team domain e.g. "team.cloudflareaccess.com", AUD tag from the Access app.
CF_ACCESS_TEAM_DOMAIN=""
CF_ACCESS_AUD=""
